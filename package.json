{
  "name": "pi-session-memory",
  "version": "0.1.0",
  "private": true,
  "description": "为 Pi 提供本地文件记忆：从历史会话提取经验、增量归并并按需召回。",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yungyu16/pi-session-memory.git"
  },
  "homepage": "https://github.com/yungyu16/pi-session-memory#readme",
  "bugs": {
    "url": "https://github.com/yungyu16/pi-session-memory/issues"
  },
  "keywords": [
    "pi-package",
    "memory"
  ],
  "files": [
    "src/**/*.ts",
    "src/lib/templates/*.md",
    "README.md",
    "docs/**/*.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": ">=0.86.1",
    "@earendil-works/pi-ai": ">=0.86.1",
    "@earendil-works/pi-coding-agent": ">=0.86.1",
    "typebox": ">=1.3.27"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "0.86.1",
    "@earendil-works/pi-ai": "0.86.1",
    "@earendil-works/pi-coding-agent": "0.86.1",
    "@earendil-works/pi-tui": "0.86.1",
    "@types/node": "22.19.19",
    "typebox": "1.3.27",
    "typescript": "5.9.3"
  }
}
